---
version: 1.5.5
title: can infer simple quoted name on left of equality
file: ./test/squirrel_test.gleam
test_name: can_infer_simple_quoted_name_on_left_of_equality_test
---

import gleam/dynamic/decode
import pog

pub type QueryRow {
  QueryRow(name: String)
}

pub fn query(
  db: pog.Connection,
  squirrel_id: Int,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use name <- decode.field(0, decode.string)
    decode.success(QueryRow(name:))
  }

  "
with squirrel_user as (select 1 as \"squirrel id\", 'Louis' as name)
select name from squirrel_user where \"squirrel id\" = $1
"
  |> pog.query
  |> pog.parameter(pog.int(squirrel_id))
  |> pog.returning(decoder)
  |> pog.execute(db)
}

