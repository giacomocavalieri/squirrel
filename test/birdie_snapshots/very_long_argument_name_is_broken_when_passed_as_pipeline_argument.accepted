---
version: 2.0.0
title: very long argument name is broken when passed as pipeline argument
file: ./test/squirrel_test.gleam
test_name: very_long_argument_name_is_broken_when_passed_as_pipeline_argument_test
---

import gleam/dynamic/decode
import pog

pub type QueryRow {
  QueryRow(this_is_a_very_very_very_long_parameter_name_test_aa: Int)
}

pub fn query(
  connection: pog.Connection,
  this_is_a_very_very_very_long_parameter_name_test_aa: Int,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use this_is_a_very_very_very_long_parameter_name_test_aa <- decode.field(
      0,
      decode.int,
    )
    decode.success(QueryRow(
      this_is_a_very_very_very_long_parameter_name_test_aa:,
    ))
  }

  "
with wibble as (select 1 as this_is_a_very_very_very_long_parameter_name_test_aa)
select *
from wibble
where $1 = this_is_a_very_very_very_long_parameter_name_test_aa
"
  |> pog.query
  |> pog.parameter(
    pog.int(this_is_a_very_very_very_long_parameter_name_test_aa),
  )
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

