---
version: 2.0.0
title: can infer simple name on left of equality
file: ./test/squirrel_test.gleam
test_name: can_infer_simple_name_on_left_of_equality_test
---

import gleam/dynamic/decode
import pog

pub type QueryRow {
  QueryRow(name: String)
}

pub fn query(
  connection: pog.Connection,
  id: Int,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use name <- decode.field(0, decode.string)
    decode.success(QueryRow(name:))
  }

  "
with squirrel_user as (select 1 as id, 'Louis' as name)
select name from squirrel_user where id = $1
"
  |> pog.query
  |> pog.parameter(pog.int(id))
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

