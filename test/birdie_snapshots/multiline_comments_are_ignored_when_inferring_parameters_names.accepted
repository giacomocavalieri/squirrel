---
version: 2.0.0
title: multiline comments are ignored when inferring parameters names
file: ./test/squirrel_test.gleam
test_name: multiline_comments_are_ignored_when_inferring_parameters_names_test
---

import gleam/dynamic/decode
import pog

pub type QueryRow {
  QueryRow(name: String)
}

pub fn query(
  connection: pog.Connection,
  name: String,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use name <- decode.field(0, decode.string)
    decode.success(QueryRow(name:))
  }

  "
with squirrel_user as (select 1 as squirrel_user_id, 'Louis' as name)
select name
from squirrel_user
/* $1 = id */
where $1 = name
/* $1 = id */
"
  |> pog.query
  |> pog.parameter(pog.text(name))
  |> pog.returning(decoder)
  |> pog.execute(connection)
}

