---
version: 1.5.5
title: renames arguments to avoid shadowing functions in scope
file: ./test/squirrel_test.gleam
test_name: renames_arguments_to_avoid_shadowing_functions_in_scope_test
---

import gleam/dynamic/decode
import pog
import youid/uuid.{type Uuid}

pub type QueryRow {
  QueryRow(uuid_decoder: Uuid)
}

pub fn query(
  db: pog.Connection,
  uuid_decoder_1: Uuid,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use uuid_decoder <- decode.field(0, uuid_decoder())
    decode.success(QueryRow(uuid_decoder:))
  }

  "
with wibble as (select gen_random_uuid() as uuid_decoder)
select uuid_decoder
from wibble
where $1 = uuid_decoder
"
  |> pog.query
  |> pog.parameter(pog.text(uuid.to_string(uuid_decoder_1)))
  |> pog.returning(decoder)
  |> pog.execute(db)
}


fn uuid_decoder() {
  use bit_array <- decode.then(decode.bit_array)
  case uuid.from_bit_array(bit_array) {
    Ok(uuid) -> decode.success(uuid)
    Error(_) -> decode.failure(uuid.v7(), "Uuid")
  }
}

