---
version: 1.5.1
title: bit decoding
file: ./test/squirrel_test.gleam
test_name: bit_decoding_test
---

import gleam/dynamic/decode
import pog

pub type QueryRow {
  QueryRow(res: BitArray)
}

pub fn query(
  db: pog.Connection,
) -> Result(pog.Returned(QueryRow), pog.QueryError) {
  let decoder = {
    use res <- decode.field(0, decode.bit_array)
    decode.success(QueryRow(res:))
  }

  "select 11::bit(4) as res"
  |> pog.query
  |> pog.returning(decoder)
  |> pog.execute(db)
}

